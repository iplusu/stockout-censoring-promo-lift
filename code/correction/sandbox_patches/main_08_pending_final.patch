+    o = _alt.fit_mix(X, K, C, 'nb', None, stN([lthN, np.log(0.95 / 0.05)])); x = _x(o)
+    rec.update(nmp_conv=o['valid'], nmp_ll=-o['obj'] * len(K) if o['valid'] else nan, nmp_pi=1 / (1 + np.exp(-x[-1])) if x is not None else nan,
+               nmp_th=float(np.exp(x[-2])) if x is not None else nan, nmp_bp=x[NPROMO] if x is not None else nan,
+               nmp_bd=x[NDEPTH] if x is not None else nan, nmp_status=o['status'])
+    return rec
